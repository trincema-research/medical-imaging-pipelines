# Full PNG crop cache + NAS deploy bundle (generated locally / via nas.pack)
rsna20*/data/processed/**
!rsna20*/data/processed/README.md
rsna2024_lumbar/nas/training_bundle/**
!rsna2024_lumbar/nas/training_bundle/.gitkeep
!rsna2024_lumbar/nas/training_bundle/train_vit_lumbar.py

# Full raw DICOM dump stays local. Label CSVs + a few smoke studies are force-added.
rsna20*/data/raw/**
!rsna20*/data/raw/README.md
!rsna20*/data/raw/train.csv
!rsna20*/data/raw/train_label_coordinates.csv
!rsna20*/data/raw/train_series_descriptions.csv

# NAS compact exports are committed under rsna2024_lumbar/data/nas_compact/ (see README there).

# Legacy path (see data/perf_pipeline/README.md) — ignore local leftovers
rsna2024_lumbar/data/perf_pipeline/**/*
!rsna2024_lumbar/data/perf_pipeline/README.md

# Best-config runs: commit summary CSVs only (not repeat_* artifacts)
rsna2024_lumbar/data/best_config_runs/results/**/repeat_*/
!rsna2024_lumbar/data/best_config_runs/results/**/pipeline_results.csv
!rsna2024_lumbar/data/best_config_runs/results/pipeline_results_all_models.csv
!rsna2024_lumbar/data/best_config_runs/results/**/pipeline_run_summary.json
rsna2024_lumbar/data/ordinal_benchmark/**/*
!rsna2024_lumbar/data/ordinal_benchmark/README.md
rsna2024_lumbar/data/best_config_runs/results/**/*.pt
rsna2024_lumbar/data/best_config_runs/results/**/*.png
